{
  "ci": {
    "collect": {
      "startServerCommand": "bunx serve out -l 4173 --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/about",
        "http://localhost:4173/projects",
        "http://localhost:4173/resume",
        "http://localhost:4173/blog",
        "http://localhost:4173/blog/noise",
        "http://localhost:4173/work-with-me"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "devtools",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 1 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile-reports"
    }
  }
}
